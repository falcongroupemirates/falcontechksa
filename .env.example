# ---------------------------------------------------------------
# Email (Resend) — contact form + request for quote
# Copy to .env.local for local dev; add the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------

# API key from https://resend.com/api-keys (needs "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender — must be on a domain verified in Resend (Domains → Add domain,
# then add the DNS records it gives you).
EMAIL_FROM="Falcon Technologies <website@falcontechksa.com>"

# Who receives the forms (comma-separated for several inboxes)
EMAIL_TO=info@falcontechksa.com
# Optional: send each form to a different inbox (falls back to EMAIL_TO)
# EMAIL_TO_ENQUIRY=info@falcontechksa.com
# EMAIL_TO_RFQ=sales@falcontechksa.com

# Send visitors a "we received your message" copy (true/false)
EMAIL_AUTOREPLY=true

# Public site URL (used for canonical/hreflang links and sitemap)
NEXT_PUBLIC_SITE_URL=https://falcontechksa.com

# Optional: logo in the email footer (public https PNG). Defaults to
# NEXT_PUBLIC_SITE_URL + /assets/logos/falcon-tech-ksa-black-logo.png
# EMAIL_LOGO_URL=https://falcontechksa.com/assets/logos/falcon-tech-ksa-black-logo.png

# ---------------------------------------------------------------
# Spam / bot protection
# ---------------------------------------------------------------
# Secret used to sign the form token (any long random string).
# Optional — falls back to one derived from RESEND_API_KEY.
# FORM_SECRET=change-me-to-a-long-random-string

# Extra hostnames allowed to post the forms (comma-separated). The site's own
# host is always allowed.
# FORM_ALLOWED_HOSTS=www.falcontechksa.com,falcontechksa.com

# Optional Cloudflare Turnstile (free, invisible CAPTCHA):
# https://dash.cloudflare.com → Turnstile → Add widget → copy both keys.
# Leave empty to skip. Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
